{
  "fileId": "{{original-file-id}}",
  "name": "THC Cleaning",
  "version": "3.0.1",
  "dataCleaning": {
    "output": {
      "fileName": "thc-clean.csv"
    },
    "rules": [
      {
        "type": "add_column",
        "id": "NE-796",
        "columnName": "time_units",
        "value": "h"
      },
      {
        "type": "find_replace",
        "id": "NE-798",
        "sourceColumn": "SUBJECTGROUP",
        "destinationColumn": "Dose_mL",
        "actions": [
          {
            "find": "A1",
            "replace": 8
          },
          {
            "find": "A2",
            "replace": 12
          },
          {
            "find": "A3",
            "replace": 2
          }
        ]
      },
      {
        "type": "conversion",
        "description": "Convert mL to mg using a per-mL multiplier",
        "id": "NE-799",
        "sourceColumn": "Dose_mL",
        "destinationColumn": "Dose_mg",
        "operator": "*",
        "column": "Dose_mg_lm_multiplier"
      },
      {
        "type": "filter",
        "id": "NE-801-filter",
        "description": "Remove excluded rows where Exclusions = Y",
        "column": "Exclusions",
        "value": "Y"
      },
      {
        "type": "max_value",
        "id": "NE-803",
        "sourceColumn": "DAYNOMINAL",
        "destinationColumn": "DAYNOMINAL",
        "maxValue": 1
      },
      {
        "type": "grouping",
        "id": "NE-806",
        "description": "A composite rule: nested rules[] are applied per group.",
        "columns": [
          "SUBJECTALIAS",
          "ANALYTE"
        ],
        "rules": [
          {
            "type": "sort",
            "id": "NE-806a",
            "columns": [
              "HOURNOMINAL"
            ],
            "direction": "asc"
          },
          {
            "type": "max",
            "id": "NE-806b",
            "sourceColumn": "CONCENTRATION",
            "destinationColumn": "TMAX"
          },
          {
            "type": "mapping",
            "id": "NE-806e",
            "columns": [
              {
                "sourceColumn": "CONCENTRATION",
                "destinationColumn": "PKLEVEL"
              }
            ]
          },
          {
            "type": "conditional",
            "id": "NE-806f",
            "description": "Zero out BLQ concentrations before Tmax",
            "conditions": [
              {
                "description": "before tmax",
                "expressions": [
                  {
                    "column": "CONCENTRATION",
                    "operator": "==",
                    "value": "< 0.500"
                  },
                  {
                    "column": "TMAX_FLAG",
                    "operator": "==",
                    "value": 0
                  }
                ],
                "action": {
                  "assign": {
                    "column": "PKLEVEL",
                    "value": 0
                  }
                }
              }
            ]
          },
          {
            "type": "blq",
            "id": "NE-808",
            "description": "Set BLQ flags relative to the first numeric concentration",
            "sourceColumn": "CONCENTRATION",
            "destinationColumn": "BLQ_FLAGS",
            "before": 0,
            "at": 1,
            "after": 2
          }
        ]
      }
    ]
  }
}
